{$DOMAIN_NAME} {
	# Upstream addresses are parameterised, not literal, because the SAME
	# file must work in two address spaces. Production's Caddy is
	# network_mode: host and reaches every backend on a published
	# 127.0.0.1 port - hence the defaults below. A branch's Caddy is
	# network_mode: service:tailscale (spec 4.2): it shares the sidecar's
	# network namespace, publishes no host ports, and must use Docker
	# service DNS. Set *_UPSTREAM in the branch's .env to switch.
	#
	# The :default half is load-bearing. A bare {$VAR} expands to EMPTY when
	# unset, and Caddy then refuses to start - which would turn this
	# branch-enablement change into a production outage at the next reload.

	
	# AFFiNE. `/affine/*` is the app entry and strips the prefix; everything
	# else AFFiNE needs is ROOT-absolute and matched by @affine below.
	handle /affine/* {
		uri strip_prefix /affine
		reverse_proxy {$AFFINE_UPSTREAM:127.0.0.1:3010} {
			header_up X-Forwarded-Prefix /affine
		}
	}
	handle /affine {
		# `redir *`, not `redir /affine/`: Caddy reads the first token after
		# `redir` as an optional MATCHER, and a token starting with `/` is one.
		# Without the `*` this reads as "for requests under /affine/, redirect
		# to `302`", which inside `handle /affine` never matches — so /affine
		# answered an empty 200 with no Location. Measured on production
		# 2026-07-31, and it had been doing that since the block was written.
		redir * /affine/ 302
	}
	# Everything AFFiNE serves from the SITE ROOT: its admin panel, its APIs,
	# the socket.io sync channel and its application shell's assets. `/affine/*`
	# returns AFFiNE's index.html, but that document then asks for
	# `/js/index.<hash>.js` and friends -- not `/affine/js/...`. With no route
	# these fell through to the basic_auth catch-all: every script 401'd and
	# the app rendered blank, and `POST /api/setup/create-admin-user` -- the
	# only way to create the first admin -- came back 401 with a zero-byte body
	# that killed the browser's res.json(). fjell (the catch-all) 404s on all
	# of these anyway, so nothing is taken from it.
	#
	# `/admin` as well as `/admin/*`: once setup is complete AFFiNE answers
	# /admin/setup with `302 -> /admin`, which a `/admin/*` matcher misses. The
	# asset prefixes are AFFiNE's own web root (`ls /app/static`), not a guess.
	#
	# The second line is the SAME defect for AFFiNE's emailed and shared links.
	# Setting External URL to `.../affine` in the admin panel does not prefix
	# them: URLHelper builds every link with `new URL(path, this.requestOrigin)`
	# -- requestOrigin, not baseUrl -- and requestOrigin is `new URL(externalUrl)
	# .origin`, which discards the path. The frontend hands it a root-absolute
	# path to begin with (`callbackUrl: "/auth/changePassword"`, hardcoded in
	# static/js/index.*.js), and even resolving against baseUrl would not help:
	# a leading `/` replaces the base's path. So these arrive at the site root
	# no matter what the admin panel says. Measured on production 2026-08-03:
	#
	#     $ curl -sI 'https://…/auth/changePassword?userId=…&token=…'
	#     HTTP/2 401
	#     www-authenticate: Basic realm="restricted"
	#
	# which is a password-reset mail that cannot be used. Same for invites,
	# magic-link sign-in and every OAuth callback. AFFINE_SERVER_SUB_PATH is
	# NOT the fix -- it mounts routes and assets under a subpath but leaves
	# URLHelper resolving against the bare origin, so the mail stays broken.
	@affine path /admin /admin/* /graphql /api/* /socket.io/* /manifest.json /apple-touch-icon.png /favicon.ico /favicon-*.png /robots.txt /js/* /assets/* /fonts/* /imgs/* /static/* /mobile/* /onboarding/* /assets-manifest.json /selfhost.html
	handle @affine {
		reverse_proxy {$AFFINE_UPSTREAM:127.0.0.1:3010}
	}

	# A SECOND named matcher with its own name, not a second `@affine path`
	# line. Reusing the name is a hard adapt error -- measured 2026-08-03:
	#
	#     Error: adapting config using caddyfile: matcher is defined more
	#            than once: @affine
	#
	# Caddy then refuses to start at all, which per the header comment above
	# turns an edit to this file into an outage at the next reload. Extending
	# the existing `path` line in place is the other correct option; a new
	# matcher keeps the emailed-link routes separately commented.
	@affine_links path /auth /auth/* /invite/* /magic-link /open-app/* /oauth/* /redirect-proxy /share/* /expired /signIn /desktop-signin
	handle @affine_links {
		reverse_proxy {$AFFINE_UPSTREAM:127.0.0.1:3010}
	}

	# Root-level hashed bundles: /styles.f5f942c3.css, /vendor.17dcb3b4.css,
	# /2bcb9d4e13c9d974.wasm. The names carry a content hash and change on
	# every AFFiNE upgrade, so they cannot be listed literally.
	#
	# Anchored to a SINGLE path segment on purpose. A plain `/*.css` would
	# also match `/git/assets/css/index.css` and take Forgejo's stylesheets,
	# and `handle` blocks are sorted by matcher specificity rather than by the
	# order they appear in this file -- so position here would not have saved
	# it. `^/[^/]+\.` cannot match anything nested.
	@affine_root_bundles path_regexp ^/[^/]+\.(css|wasm|js|map)$
	handle @affine_root_bundles {
		reverse_proxy {$AFFINE_UPSTREAM:127.0.0.1:3010}
	}

	# The hub — the stack's front door, served by fjell.
	#
	# It lives UNDER /git/ for one reason: Forgejo's session cookie is
	# Path=/git/ (measured 2026-07-31 on production —
	# `set-cookie: persistent=; Path=/git/`). At the site root the browser
	# sends fjell nothing it could identify the caller with, and the hub's
	# whole job is to route each developer to their OWN agent. Mounted here,
	# the browser hands fjell the Forgejo cookie and fjell asks Forgejo who it
	# belongs to.
	#
	# `.hub` cannot collide with a Forgejo user page: Forgejo usernames must
	# begin with an alphanumeric, so no account can ever own /git/.hub.
	# Declared BEFORE handle /git/* so the intent is readable; Caddy also
	# sorts handle matchers most-specific-first, so order here is belt and
	# braces, not the mechanism.
	handle_path /git/.hub/* {
		reverse_proxy {$FJELL_UPSTREAM:127.0.0.1:9080}
	}
	handle /git/.hub {
		redir * /git/.hub/ 302
	}

	# The pretty entry point.
	handle / {
		redir * /git/.hub/ 302
	}

	# Forgejo at /git/
	handle /git/* {
		uri strip_prefix /git
		reverse_proxy {$FORGEJO_UPSTREAM:127.0.0.1:3000}
	}

	# Hermes dashboard — served via Tailscale Serve on :7444.
	handle /agent {
		redir https://{$DOMAIN_NAME}:{$HERMES_SERVE_PORT}/ 302
	}

	

	# Per-developer agent dashboards — generated by dev-admin reconcile
	import /etc/caddy/Caddyfile.d/agents.conf

	# Catch-all. fjell serves only the paths reached through the handles above,
	# so anything landing here is a 404 from fjell.
	handle {
		reverse_proxy {$FJELL_UPSTREAM:127.0.0.1:9080}
	}
}

