#!/usr/bin/env sh
# Host-side entry point. Runs from the production checkout OR any worktree.
#
# PYTHONPATH is not optional: the package lives in aurora-cli/aurora_cli, so
# `python -m aurora_cli` cannot find it from the repository root without the
# aurora-cli directory on the import path. That import happens before any
# Python this repository owns gets to run, so it cannot be fixed from inside
# the package.
#
# AURORA_PYTHON overrides the interpreter, for a fresh worktree that has no
# .venv yet -- which is the situation `aurora branch up` exists to create.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

PYTHONPATH="$here/aurora-cli${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "${AURORA_PYTHON:-$here/.venv/bin/python}" -m aurora_cli "$@"
