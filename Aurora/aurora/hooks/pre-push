#!/bin/sh
# Spec 5.4, layer 2 (mechanical): refuse a push whose remote is a BRANCH forge.
#
# A branch stack runs its own Forgejo on its own tailnet host. That forge is
# destroyed with the branch (`aurora branch down` takes its volumes with it),
# so a commit pushed there is not "somewhere else" -- it is GONE. The three
# layers spec 5.4 asks for are:
#
#   1. structural -- a branch worktree inherits `origin`, which points at
#      PRODUCTION's forge; reaching a branch forge takes a deliberate
#      `git remote add`. Already true; asserted, not built.
#   2. mechanical -- this file.
#   3. visual     -- the branch forge renders as `<app name> [BRANCH: <name>]`.
#
# NOTHING IS TYPED HERE. Not production's hostname, not the tailnet, not the
# product name. Every value is derived the same way aurora_cli.identity derives
# it, and aurora-cli/tests/test_crosswire.py pins the agreement between the two
# derivations -- a second, drifting copy of "what is production" is the defect
# this repository has already paid for twice.
#
# HOW IT IS INSTALLED, and why not into .git/hooks. Git worktrees SHARE
# .git/hooks with the main checkout: from a branch worktree,
# `git rev-parse --git-path hooks` resolves into the COMMON .git, i.e. into
# PRODUCTION's checkout. Writing a hook from a branch worktree would therefore
# write to production. The wiring used instead is a RELATIVE `core.hooksPath`,
# which git resolves against each worktree's own root (measured on git 2.55):
#
#     git -C <production checkout> config core.hooksPath hooks
#
# One line, once, by a human -- it is a write to production's .git/config and
# no automation in this repository may make it. It is production-neutral: this
# hook allows production's own forge, so an armed production behaves exactly as
# an unarmed one. See docs/post-implementation-steps.md and
# aurora_cli.crosswire.arming_command().
#
# THE FAILURE MODE THIS IS WRITTEN AROUND: a hook that blocks a legitimate push
# gets deleted by the first developer who hits it, which is strictly worse than
# no hook. Production's domain and a branch's domain share a tailnet suffix, so
# matching the suffix would block every push including the correct one. The
# rules below therefore ALLOW production's exact host first, and reject only
# hosts carrying the branch prefix. `--no-verify` is advertised in the refusal
# on purpose, for the same reason.

set -u

MARKER='aurora pre-push:'          # the string tests assert on. A missing or
                                   # non-executable hook is silently skipped by
                                   # git, and `git hook run` reports the same
                                   # exit 1 as a refusal -- so "exit != 0" does
                                   # NOT prove this hook ran. This does.

# Consume the ref lines git feeds us so it never sees a broken pipe. Guarded on
# a tty because a bare `cat` with an interactive stdin HANGS FOREVER, which is
# the same trap that a compose call with an open stdin cost this project in
# Task 6.
if [ ! -t 0 ]; then
    cat > /dev/null 2>&1 || :
fi

die() {
    printf '%s %s\n' "$MARKER" "$1" >&2
    shift
    for _line in "$@"; do
        # Empty entries come from `${var:+...}` continuations that had nothing
        # to say; printing them would leave blank lines mid-message.
        [ -n "$_line" ] && printf '  %s\n' "$_line" >&2
    done
    exit 1
}

# A URL with its userinfo removed. `origin` in this repository carries a
# Forgejo access token in the URL, so anything printed must be redacted or the
# refusal message leaks a credential into terminals, CI logs and screenshots.
redact() {
    printf '%s' "$1" | sed -e 's,://[^/@]*@,://***@,' -e 's,^[^/:]*@,***@,'
}

# The last uncommented `KEY=value` in an env file, NORMALISED, or nothing.
#
# Normalised rather than taken verbatim, and that is finding F3. This
# repository has three .env readers -- aurora_cli.identity._read_env_file,
# aurora_cli.envfile.parse_env, and this function -- and measured on
# 2026-07-30 they disagreed on 6 of 9 value shapes. The consequence here was
# not a malformed read but a defence that FAILED OPEN: with
#
#     DOMAIN_NAME="host.tailnet"
#
# the quote rode along into `suffix` below, the branch host stopped matching
# it, and a push to a BRANCH forge fell through to the allow-everything rule.
# Measured, pushing at https://<product>-demo.<tailnet>/git/x/y.git:
# double-quoted, single-quoted and trailing-space all gave verdict=allow where
# the unquoted form correctly gives verdict=reject.
#
# Whitespace around `=` was not fail-open but was not right either: the old
# pattern did not match the line at all, production's domain came out EMPTY,
# and production was then allowed by FALL-THROUGH (verdict=allow) rather than
# recognised (verdict=allow-production). That is Task 7's M7 finding again --
# `exit 0` with two sources -- so the tests here assert on the verdict.
#
# The rule is identity._read_env_file()'s, deliberately identical: tolerate
# whitespace around `=`, strip surrounding whitespace, then strip ONE matching
# pair of surrounding quotes. envfile.parse_env REFUSES these shapes outright,
# so for any value that reaches a branch all three readers agree.
env_value() {
    [ -f "$1" ] || return 0
    sed -n "s/^[[:space:]]*$2[[:space:]]*=//p" "$1" \
        | tr -d '\r' | tail -n 1 \
        | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
              -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

# The host component of a git remote URL, or empty when the URL names no host
# (a local path). Userinfo, port and path are all stripped -- and the userinfo
# strip is load-bearing rather than tidy: this repository's own origin is
# `https://<user>:<token>@<production host>/git/...`, so a parser that kept the
# userinfo would fail to recognise PRODUCTION and would block the one push that
# must always work.
remote_host() {
    _u=$1
    case $_u in
        *://*)
            _u=${_u#*://}
            ;;
        /*|./*|../*|~*)
            return 0                       # a local path names no host
            ;;
        *:*)
            # scp-like [user@]host:path -- but only when what precedes the
            # first colon holds no slash, otherwise it is a path that happens
            # to contain a colon.
            case ${_u%%:*} in
                */*) return 0 ;;
            esac
            _u=${_u%%:*}
            ;;
        *)
            return 0                       # bare relative path
            ;;
    esac
    _u=${_u%%/*}                           # drop /path
    _u=${_u#*@}                            # drop userinfo
    _u=${_u%%:*}                           # drop :port
    printf '%s' "$_u"
}

remote_name=${1-}
remote_url=${2-}

# The checkout this hook is running for. Git chdirs to the worktree root before
# running a hook, so $PWD is normally it; asking git is still cheaper than
# being wrong once.
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
[ -n "$top" ] || top=$PWD

# The product name, from the TRACKED .env.template -- the one source that reads
# the same before and after the blocked project rename, and the same one
# aurora_cli.identity.declared_project() uses. Never from .env: a branch's .env
# describes the BRANCH.
product=$(env_value "$top/.env.template" COMPOSE_PROJECT_NAME)
prefix="$product-"

# Production's checkout is the MAIN worktree; git lists it first. Same
# derivation as aurora_cli.identity.production_root().
prod_root=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -n 1)
prod_domain=""
if [ -n "${prod_root:-}" ]; then
    prod_domain=$(env_value "$prod_root/.env" DOMAIN_NAME)
fi
# `<host>.<tailnet>` -> `<tailnet>`. Empty when production's .env is absent,
# which is the fresh-clone case and is handled below rather than fatal.
suffix=""
case $prod_domain in
    *.*) suffix=${prod_domain#*.} ;;
esac

host=$(remote_host "$remote_url")

if [ "${AURORA_PRE_PUSH_EXPLAIN:-}" = "1" ]; then
    printf 'product=%s\n' "$product"
    printf 'branch-hostname-prefix=%s\n' "$prefix"
    printf 'production-domain=%s\n' "$prod_domain"
    printf 'tailnet-suffix=%s\n' "$suffix"
    printf 'remote-name=%s\n' "$remote_name"
    printf 'remote-host=%s\n' "$host"
fi

# ---------------------------------------------------------------- the rules

# Fail closed, twice, and both are deliberate. A hook that cannot tell a branch
# forge from production must not wave the push through: the developer would
# believe a defence is in place that is not. Both messages say exactly what to
# do, because an unexplained refusal is the other way this gets deleted.
if [ -z "$remote_url" ]; then
    die "cannot determine which remote this push is aimed at." \
        "git passes the remote name and URL to pre-push; this invocation had" \
        "name=${remote_name:-<none>} url=<none>. Refusing rather than guessing." \
        "Push again through git, or bypass with --no-verify."
fi

if [ -z "$product" ]; then
    die "cannot derive the product name, so a branch forge and production are" \
        "indistinguishable from here." \
        "Expected COMPOSE_PROJECT_NAME in $top/.env.template (a tracked file)." \
        "Restore it, or unset core.hooksPath to disable this hook deliberately" \
        "rather than by accident."
fi

# 1. Production's exact host is always allowed. FIRST, so that a production
#    host which itself began with the branch prefix would still be pushable.
if [ -n "$prod_domain" ] && [ "$host" = "$prod_domain" ]; then
    [ "${AURORA_PRE_PUSH_EXPLAIN:-}" = "1" ] && printf 'verdict=allow-production\n'
    exit 0
fi

# 2. A host carrying the branch prefix is a branch forge. Qualified by the
#    tailnet suffix when it is known, so `aurora-something.github.com` is not
#    caught; a bare label with no dot at all IS caught, because MagicDNS
#    resolves `aurora-demo` on its own.
is_branch=no
case $host in
    "$prefix"?*)
        case $host in
            *.*)
                if [ -z "$suffix" ] || [ "$host" != "${host%".$suffix"}" ]; then
                    is_branch=yes
                fi
                ;;
            *)
                is_branch=yes
                ;;
        esac
        ;;
esac

# 3. Fail-safe: a URL this parser found no host in, but which spells a branch
#    forge's full name anyway (an insteadOf rewrite, a shape not anticipated
#    here). Requires the full `<prefix>...<tailnet>` form, so an ordinary local
#    path merely containing the product name is not caught.
if [ "$is_branch" = no ] && [ -z "$host" ] && [ -n "$suffix" ]; then
    case $remote_url in
        *"$prefix"*".$suffix"*) is_branch=yes ;;
    esac
fi

if [ "$is_branch" = yes ]; then
    [ "${AURORA_PRE_PUSH_EXPLAIN:-}" = "1" ] && printf 'verdict=reject\n'
    die "refusing to push to a BRANCH forge." \
        "remote:      ${remote_name:-<unnamed>} -> $(redact "$remote_url")" \
        "branch host: ${host:-<none parsed; matched the URL text>}" \
        "A branch's Forgejo is destroyed with the branch, volumes included, so" \
        "commits pushed there are LOST rather than merely misplaced." \
        "${prod_domain:+Push to production instead: $prod_domain}" \
        "If this really is what you meant, push with --no-verify."
fi

[ "${AURORA_PRE_PUSH_EXPLAIN:-}" = "1" ] && printf 'verdict=allow\n'
exit 0
