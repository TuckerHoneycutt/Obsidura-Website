# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Must be a verified sender/domain in Resend.
# For local testing you can use: Obsidura <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Obsidura <contact@obsidura.com>

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=contact@obsidura.com

# Cloudflare Turnstile — Cloudflare dashboard > Turnstile.
# The site key is inlined at build time: redeploy after changing it.
# For local dev and Netlify deploy previews use Cloudflare's test keys
# (they work on any hostname, including localhost):
#   always passes: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
#   always fails:  site 2x00000000000000000000AB / secret 2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to true in Netlify's production context only: the contact API then
# rejects posts not addressed to obsidura.com (e.g. the *.netlify.app URL).
CONTACT_ENFORCE_HOST=
